{
  "version": 1,
  "adapters": {
    "xiaohongshu": {
      "enabled": true,
      "access": "read",
      "scope": "xhs",
      "tools": ["search", "note", "comments", "publish"],
      "names": {
        "search": "xiaohongshu_search_notes",
        "note": "xiaohongshu_get_note",
        "comments": "xiaohongshu_get_comments",
        "publish": "xiaohongshu_publish_note"
      },
      "legacyNames": {
        "search": "search_notes",
        "note": "get_note",
        "comments": "get_comments"
      },
      "session": { "mode": "persistent", "keepTab": true, "window": "foreground" },
      "rules": {
        "search": {
          "query": { "minLength": 1, "maxLength": 80 },
          "limit": { "min": 1, "max": 10, "default": 5 }
        },
        "note": {
          "note-id": {
            "publicName": "url",
            "maxLength": 1000,
            "url": {
              "hostname": "www.xiaohongshu.com",
              "pathnamePattern": "^/(explore|search_result)/[0-9a-f]{24}$",
              "requiredQuery": ["xsec_token"]
            }
          }
        },
        "comments": {
          "note-id": {
            "publicName": "url",
            "maxLength": 1000,
            "url": {
              "hostname": "www.xiaohongshu.com",
              "pathnamePattern": "^/(explore|search_result)/[0-9a-f]{24}$",
              "requiredQuery": ["xsec_token"]
            }
          },
          "limit": { "min": 1, "max": 20, "default": 10 }
        },
        "publish": {
          "title": { "minLength": 1, "maxLength": 20 },
          "content": { "minLength": 1, "maxLength": 5000 },
          "draft": { "default": true }
        }
      }
    },
    "xianyu": {
      "enabled": true,
      "access": "read",
      "tools": ["search", "item", "publish"],
      "names": {
        "search": "xianyu_search_items",
        "item": "xianyu_get_item",
        "publish": "xianyu_publish_item"
      },
      "session": { "mode": "ephemeral", "keepTab": false },
      "rules": {
        "search": {
          "query": { "minLength": 1, "maxLength": 80 },
          "limit": { "min": 1, "max": 10, "default": 5 }
        },
        "item": {
          "item_id": { "pattern": "^[0-9]{1,30}$" }
        },
        "publish": {
          "title": { "minLength": 1, "maxLength": 80 },
          "description": { "minLength": 1, "maxLength": 5000 },
          "price": { "min": 0.01, "max": 1000000 },
          "condition": { "pattern": "^(全新|几乎全新|轻微使用|明显使用|老旧)$" }
        }
      }
    }
  }
}
